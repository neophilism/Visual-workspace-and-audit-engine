{
  "name": "@accountability/visual-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "default": "./dist/operations.js"
    },
    "./inbox": {
      "types": "./dist/inbox.d.ts",
      "default": "./dist/inbox.js"
    },
    "./operator-client": {
      "types": "./dist/operator-client.d.ts",
      "default": "./dist/operator-client.js"
    },
    "./operator-controls": {
      "types": "./dist/operator-controls.d.ts",
      "default": "./dist/operator-controls.js"
    },
    "./acquisition": {
      "types": "./dist/acquisition.d.ts",
      "default": "./dist/acquisition.js"
    },
    "./caption-review": {
      "types": "./dist/caption-review.d.ts",
      "default": "./dist/caption-review.js"
    },
    "./consent-review": {
      "types": "./dist/consent-review.d.ts",
      "default": "./dist/consent-review.js"
    },
    "./text-jobs": {
      "types": "./dist/text-jobs.d.ts",
      "default": "./dist/text-jobs.js"
    },
    "./reconciliation-client": {
      "types": "./dist/reconciliation-client.d.ts",
      "default": "./dist/reconciliation-client.js"
    },
    "./reconciliation-controls": {
      "types": "./dist/reconciliation-controls.d.ts",
      "default": "./dist/reconciliation-controls.js"
    },
    "./participant-controls": {
      "types": "./dist/participant-controls.d.ts",
      "default": "./dist/participant-controls.js"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && node scripts/validate-pr-registry.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "example:inbox": "npm run build && node scripts/render-inbox-example.mjs",
    "example:acquisition": "npm run build && node scripts/render-acquisition-example.mjs",
    "example:captions": "npm run build && node scripts/render-caption-example.mjs",
    "example:consents": "npm run build && node scripts/render-consent-example.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/jsdom": "21.1.7",
    "@types/node": "26.6.5",
    "jsdom": "26.1.0",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "dependencies": {
    "@accountability/consent-rights": "github:neophilism/Consent-rights-and-use-decisions-engine#43c4d786be774ee61c03c8ec599c4ee3521046e9",
    "@accountability/correspondence": "git+https://github.com/neophilism/Correspondence-and-Outreach-Engine.git#97778c1212a02194e61a27f53b928f098af81b88",
    "@accountability/discovery-acquisition": "git+https://github.com/neophilism/Discovery-and-Acquisition-Engine.git#f87ba8cba1bde7d47c90dd7375f501728ffc40e0",
    "@accountability/packaging-release": "git+https://github.com/neophilism/Packaging-release-and-correction-engine.git#b3ddcaeba1bef27310ff2113d6abca9a249b40a7",
    "@accountability/processing": "github:neophilism/Document-and-Media-Processing-Engine#44d76aefb8701852398182a158248c1b6b7a8fda",
    "@accountability/resources": "git+https://github.com/neophilism/Resources-and-commercial-operations-engine.git#5a1ed825fef938702c333066935afea4c42f9b21"
  }
